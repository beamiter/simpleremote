#!/usr/bin/env bash
set -Eeuo pipefail

: "${SIMPLEREMOTE_TEST_TARGET:?}"

if [[ ${1:-} != -T ]]; then
  printf 'unexpected ssh invocation:' >&2
  printf ' <%s>' "$@" >&2
  printf '\n' >&2
  exit 64
fi

shift
while [[ ${1:-} == -o ]]; do
  [[ $# -ge 2 ]] || exit 64
  shift 2
done
if [[ $# -ne 4 || $1 != "$SIMPLEREMOTE_TEST_TARGET" \
      || $2 != sh || $3 != -c ]]; then
  printf 'unexpected ssh invocation:' >&2
  printf ' <%s>' "$@" >&2
  printf '\n' >&2
  exit 64
fi

# OpenSSH joins everything after the target and lets the login shell parse it.
# Reproduce that boundary locally so the Vim test exercises the real agent.
remote_command=$(printf '%s ' "${@:2}")
remote_command=${remote_command% }
exec sh -c "$remote_command"
